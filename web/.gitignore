# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.cache/

# OpenNext / Cloudflare build output (generated by `opennextjs-cloudflare build`)
/.open-next/
/.wrangler/
# bindings-only dev config generated by scripts/wrangler-dev-config.mjs
/wrangler.dev.json

# production env (contains secrets — never commit)
.env.production
.env.production.local

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Module mounts (scripts/ensure-module-mounts.mjs). NEVER git-add these.
# Real source: BWMS/modules/m-*/client. Git tracking both paths is why
# merge/checkout "Accept theirs" on apps can drop module work.
# Keep tracked (shell only): layout/page/globals/providers/error,
# api-backend proxy, middleware, configs, public/, stubs/, scripts/.
# ---------------------------------------------------------------------------
/lib/
/features/
/modules/

/utils/
/contexts/
/providers/
/types/
/data/
/styles/
/services/
/hooks/
/components/
/operational/
/app/HomePageClient.tsx
/app/login/
/app/admin/
/app/register/
/app/trp/
/app/maas/
/app/grooming/
/app/log-data/
/app/uld/
/app/fris/
/app/others/
/app/billing/
/app/safety-incident/
/app/chr/
/app/batest/
/app/gemm/
/app/hr/
/app/manuals/
/app/compliance/
