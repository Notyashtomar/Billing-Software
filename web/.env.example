# Server-only (set via `wrangler secret put GROQ_API_KEY` in production)
GROQ_API_KEY=your_groq_api_key_here

# Optional: backend URL for local dev (Next rewrites /api-backend)
# Local `next dev` always uses http://127.0.0.1:8080 — these are for production Worker deploy only:
# NEXT_PUBLIC_API_URL=https://fris-production.up.railway.app
# API_BACKEND_URL=https://fris-production.up.railway.app
