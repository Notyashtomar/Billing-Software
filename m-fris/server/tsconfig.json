{
  "extends": "../../tsconfig.server.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDirs": [
      ".",
      "../../m-platform/server",
      "../../m-admin/server",
      "../../m-billing/server/src"
    ],
    "paths": {
