# ---------------------------------------------------------------------------
# Module mounts (scripts/ensure-module-mounts.mjs). NEVER git-add these.
# Real source: BWMS/modules/m-*/server. Keep only Nest shell files in src/.
# ---------------------------------------------------------------------------
/src/*
!/src/app.module.ts
!/src/app.controller.ts
!/src/app.controller.spec.ts
!/src/app.service.ts
!/src/main.ts
